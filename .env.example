# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit ".env" to Git. It is already listed in .gitignore.
# NEVER paste real keys into chats, screenshots or documents.
# ---------------------------------------------------------------

# --- API server (apps/api) ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Supabase (Project Settings > API) ---
# Project URL, looks like https://abcdefgh.supabase.co
SUPABASE_URL=
# The PUBLISHABLE (anon) key. Used only by the server in our design.
SUPABASE_ANON_KEY=
# The SECRET (service role) key. Skips the database guards: keep it private!
# Not used until the user-management step. Safe to fill in now.
SUPABASE_SERVICE_ROLE_KEY=
